# Copy this file to ".env" and fill in your real values. NEVER commit .env.

# --- Telegram (required) ---
# Create a bot via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=

# Your own Telegram numeric user id (the bot will ONLY talk to this id).
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_OWNER_ID=

# --- Anthropic / Claude (optional) ---
# Powers the plain-language rationale in the digest. Leave blank and the bot
# still works — recommendations fall back to the engine's terse computed notes.
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Model used to NARRATE signals (it never picks stocks or invents numbers).
ANTHROPIC_MODEL=claude-opus-5

# --- News / sentiment (optional; free tier) ---
# https://finnhub.io  -> free API key. Leave blank to skip news signals for now.
FINNHUB_API_KEY=

# --- Behaviour ---
# Timezone + time for the daily digest.
DIGEST_TIMEZONE=Europe/Istanbul
DIGEST_TIME=08:30

# Where the SQLite database lives (relative to project root).
DB_PATH=data/portfolio.db
